@model _25dh110017_Mystore.Models.Category

@{
    ViewBag.Title = "Xác nhận xóa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid my-4" style="max-width: 650px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-danger text-white py-3">
            <h4 class="fw-bold m-0">⚠️ XÁC NHẬN XÓA DANH MỤC</h4>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-warning mb-4" role="alert">
                <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa danh mục này khỏi hệ thống không?
            </div>

            <div class="mb-3 row">
                <label class="col-sm-4 fw-bold text-secondary">Mã danh mục:</label>
                <div class="col-sm-8 fw-bold">#@Model.CategoryID</div>
            </div>

            <div class="mb-4 row">
                <label class="col-sm-4 fw-bold text-secondary">Tên danh mục:</label>
                <div class="col-sm-8 text-primary fw-bold fs-5">@Model.CategoryName</div>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">
                        ← Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-danger px-4 fw-bold">
                        🗑️ Xác nhận xóa
                    </button>
                </div>
            }
        </div>
    </div>
</div>
