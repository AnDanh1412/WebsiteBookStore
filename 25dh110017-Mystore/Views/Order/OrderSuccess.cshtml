@model _25dh110017_Mystore.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderID + " - MyStore";
}

<div class="container my-4" style="max-width: 850px;">
    <!-- NÚT QUAY LẠI -->
    <div class="mb-3">
        <a href="@Url.Action("History", "Order")" class="btn btn-outline-secondary btn-sm">
            ← Quay lại lịch sử đơn hàng
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show p-3 shadow-sm mb-3" role="alert">
            <strong>⚠️ Thông báo:</strong> @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <!-- HEADER THÔNG TIN ĐƠN HÀNG -->
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h4 class="fw-bold text-dark m-0">📄 Chi tiết đơn hàng #@Model.OrderID</h4>
                <small class="text-muted">Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</small>
            </div>
            <div>
                @if (Model.PaymentStatus == "Đang xử lý" || Model.PaymentStatus == "Pending")
                {
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fs-6">⏳ Đang xử lý</span>
                }
                else if (Model.PaymentStatus == "Đã xác nhận")
                {
                    <span class="badge bg-primary px-3 py-2 rounded-pill fs-6">✅ Đã xác nhận</span>
                }
                else if (Model.PaymentStatus == "Đang giao")
                {
                    <span class="badge bg-info text-dark px-3 py-2 rounded-pill fs-6">🚚 Đang giao</span>
                }
                else if (Model.PaymentStatus == "Đã giao")
                {
                    <span class="badge bg-success px-3 py-2 rounded-pill fs-6">🎉 Đã giao</span>
                }
                else if (Model.PaymentStatus == "Đã hủy" || Model.PaymentStatus == "Cancelled")
                {
                    <span class="badge bg-secondary px-3 py-2 rounded-pill fs-6">❌ Đã hủy</span>
                }
                else
                {
                    <span class="badge bg-light text-dark px-3 py-2 rounded-pill border fs-6">@Model.PaymentStatus</span>
                }
            </div>
        </div>

        <div class="card-body p-4">
            <!-- THÔNG TIN GIAO NHẬN -->
            <div class="row mb-4">
                <div class="col-md-6 mb-3 mb-md-0">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <h6 class="fw-bold text-secondary mb-2">👤 Thông tin người nhận</h6>
                        <p class="mb-1"><strong>Họ tên:</strong> @(Model.Customer != null ? Model.Customer.CustomerName : "Khách vãng lai")</p>
                        <p class="mb-1"><strong>Số điện thoại:</strong> @(Model.Customer != null && !string.IsNullOrEmpty(Model.Customer.CustomerPhone) ? Model.Customer.CustomerPhone : "Chưa cập nhật")</p>
                        <p class="mb-0"><strong>Địa chỉ nhận:</strong> @Model.AddressDelivery</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <h6 class="fw-bold text-secondary mb-2">💳 Trạng thái thanh toán</h6>
                        <p class="mb-1"><strong>Phương thức:</strong> Thanh toán khi nhận hàng (COD)</p>
                        <p class="mb-1">
                            <strong>Trạng thái:</strong>
                            <span class="text-primary fw-bold">@Model.PaymentStatus</span>
                        </p>
                        <p class="mb-0">
                            <strong>Tổng thanh toán:</strong>
                            <span class="text-danger fw-bold fs-5">@string.Format("{0:N0} VNĐ", Model.TotalAmount)</span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- DANH SÁCH SẢN PHẨM -->
            <h6 class="fw-bold text-dark mb-3">🛒 Danh sách sản phẩm</h6>
            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-end" style="width: 140px;">Đơn giá</th>
                            <th class="text-center" style="width: 90px;">Số lượng</th>
                            <th class="text-end" style="width: 150px;">Thành tiền</th>
                            <th class="text-center" style="width: 110px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                        {
                            foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            @(item.Product != null ? item.Product.ProductName : (!string.IsNullOrEmpty(item.ProductName) ? item.ProductName : "Sản phẩm đã mua"))
                                            @if (item.Product == null)
                                            {
                                                <span class="badge bg-secondary ms-1 small" title="Sản phẩm đã hết hàng / không còn kinh doanh">Hết hàng</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        @string.Format("{0:N0} đ", item.UnitPrice)
                                    </td>
                                    <td class="text-center fw-bold">
                                        @item.Quantity
                                    </td>
                                    <td class="text-end text-danger fw-bold">
                                        @string.Format("{0:N0} đ", item.UnitPrice * item.Quantity)
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("ReOrder", "Order", new { productId = item.ProductID })" class="btn btn-sm btn-outline-primary">
                                            🔄 Mua lại
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">Không có chi tiết sản phẩm.</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                            <td class="text-end text-danger fw-bold fs-5">
                                @string.Format("{0:N0} VNĐ", Model.TotalAmount)
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- CÁC NÚT ĐIỀU HƯỚNG -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top">
                <a href="@Url.Action("History", "Order")" class="btn btn-outline-secondary">
                    ← Trở lại lịch sử đơn hàng
                </a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary px-4 fw-bold">
                    🛒 Tiếp tục mua sắm
                </a>
            </div>
        </div>
    </div>
</div>
