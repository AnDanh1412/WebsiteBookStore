@model _25dh110017_Mystore.Models.Product

@{
    ViewBag.Title = "Xác nhận xóa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    bool canDelete = ViewBag.CanDelete == null || (bool)ViewBag.CanDelete;
    string warning = ViewBag.DeleteWarning as string;
}

<div class="container-fluid my-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-danger text-white py-3">
            <h4 class="fw-bold m-0">🗑️ XÁC NHẬN XÓA SẢN PHẨM</h4>
        </div>

        <div class="card-body p-4">
            @if (!canDelete)
            {
                <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                    <div class="fs-4 me-3">⚠️</div>
                    <div>
                        <strong class="d-block">Không thể xóa sản phẩm lúc này:</strong>
                        <span>@(warning ?? "Không thể xóa vì có khách hàng đã đặt hàng, vui lòng thử lại sau!")</span>
                    </div>
                </div>
            }
            else
            {
                if (ViewBag.DeleteInfo != null)
                {
                    <div class="alert alert-info mb-4" role="alert">
                        <strong>ℹ️ Thông tin:</strong> @ViewBag.DeleteInfo
                    </div>
                }
                <div class="alert alert-warning mb-4" role="alert">
                    <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa sản phẩm <strong>@Model.ProductName</strong> khỏi hệ thống?
                </div>
            }

            <!-- Thông tin sản phẩm -->
            <div class="card border p-3 mb-4 bg-light">
                @Html.Partial("PVProductInfo", Model)
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">
                        ← Quay lại danh sách
                    </a>

                    @if (canDelete)
                    {
                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                            Xác nhận xóa
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary px-4 fw-bold" disabled title="Sản phẩm đang có người đặt mua">
                            Không thể xóa
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>
