@model _25dh110017_Mystore.Models.Order

@{
    ViewBag.Title = "Chỉnh sửa đơn hàng #" + Model.OrderID;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid my-4" style="max-width: 800px;">
    <div class="d-flex align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">✏️ Chỉnh sửa Đơn hàng #@Model.OrderID</h2>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="card shadow-sm border-0 rounded-3 p-4">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.OrderID)
            @Html.HiddenFor(model => model.CustomerID)
            @Html.HiddenFor(model => model.OrderDate)
            @Html.HiddenFor(model => model.TotalAmount)

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Khách hàng</label>
                <input type="text" class="form-control" value="@(Model.Customer != null ? Model.Customer.CustomerName : "Khách vãng lai")" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Ngày đặt hàng</label>
                <input type="text" class="form-control" value="@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Tổng tiền</label>
                <input type="text" class="form-control text-danger fw-bold fs-5" value="@string.Format("{0:N0} VNĐ", Model.TotalAmount)" readonly />
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.AddressDelivery, "Địa chỉ giao hàng", htmlAttributes: new { @class = "form-label fw-bold text-secondary" })
                @Html.EditorFor(model => model.AddressDelivery, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.AddressDelivery, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.PaymentStatus, "Trạng thái đơn hàng", htmlAttributes: new { @class = "form-label fw-bold text-secondary" })
                @Html.DropDownListFor(model => model.PaymentStatus, (SelectList)ViewBag.StatusList, new { @class = "form-select" })
                @Html.ValidationMessageFor(model => model.PaymentStatus, "", new { @class = "text-danger small" })
            </div>

            <div class="mt-4 pt-3 border-top d-flex justify-content-between">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">← Quay lại danh sách</a>
                <button type="submit" class="btn btn-primary px-4 fw-bold">💾 Lưu thay đổi</button>
            </div>
        </div>
    }
</div>
