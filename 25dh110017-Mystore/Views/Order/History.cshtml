@model IEnumerable<_25dh110017_Mystore.Models.Order>

@{
    ViewBag.Title = "Lịch sử đơn hàng - MyStore";
    string currentStatus = ViewBag.CurrentStatus as string ?? "All";
    var counts = ViewBag.Counts as Dictionary<string, int> ?? new Dictionary<string, int>();

    int CountOf(string key) => counts.ContainsKey(key) ? counts[key] : 0;
}

<div class="container my-4" style="max-width: 1100px;">
    <!-- TIÊU ĐỀ TRANG -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-dark m-0">📦 Đơn hàng của tôi</h3>
            <p class="text-muted small mb-0">Theo dõi và quản lý trạng thái các đơn đặt hàng</p>
        </div>
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-sm">
            ← Tiếp tục mua sắm
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show p-2 px-3 small" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show p-2 px-3 small" role="alert">
            ⚠️ @TempData["ErrorMessage"]
        </div>
    }

    <!-- THANH TAB PHÂN LOẠI TRẠNG THÁI (KIỂU TIKTOK SHOP / SHOPEE) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">
            <ul class="nav nav-tabs nav-fill border-0 flex-nowrap overflow-auto order-status-tabs">
                <li class="nav-item">
                    <a class="nav-link py-3 @(currentStatus == "All" ? "active fw-bold text-primary" : "text-secondary")"
                       href="@Url.Action("History", "Order", new { status = "All" })">
                        Tất cả
                        <span class="badge rounded-pill bg-light text-dark ms-1">@CountOf("All")</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-3 @(currentStatus == "Đang xử lý" ? "active fw-bold text-warning" : "text-secondary")"
                       href="@Url.Action("History", "Order", new { status = "Đang xử lý" })">
                        ⏳ Chờ xử lý
                        @if (CountOf("Đang xử lý") > 0)
                        {
                            <span class="badge rounded-pill bg-warning text-dark ms-1">@CountOf("Đang xử lý")</span>
                        }
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-3 @(currentStatus == "Đã xác nhận" ? "active fw-bold text-primary" : "text-secondary")"
                       href="@Url.Action("History", "Order", new { status = "Đã xác nhận" })">
                        ✅ Đã xác nhận
                        @if (CountOf("Đã xác nhận") > 0)
                        {
                            <span class="badge rounded-pill bg-primary ms-1">@CountOf("Đã xác nhận")</span>
                        }
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-3 @(currentStatus == "Đang giao" ? "active fw-bold text-info" : "text-secondary")"
                       href="@Url.Action("History", "Order", new { status = "Đang giao" })">
                        🚚 Đang giao
                        @if (CountOf("Đang giao") > 0)
                        {
                            <span class="badge rounded-pill bg-info text-dark ms-1">@CountOf("Đang giao")</span>
                        }
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-3 @(currentStatus == "Đã giao" ? "active fw-bold text-success" : "text-secondary")"
                       href="@Url.Action("History", "Order", new { status = "Đã giao" })">
                        🎉 Đã giao
                        @if (CountOf("Đã giao") > 0)
                        {
                            <span class="badge rounded-pill bg-success ms-1">@CountOf("Đã giao")</span>
                        }
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-3 @(currentStatus == "Đã hủy" ? "active fw-bold text-danger" : "text-secondary")"
                       href="@Url.Action("History", "Order", new { status = "Đã hủy" })">
                        ❌ Đã hủy
                        @if (CountOf("Đã hủy") > 0)
                        {
                            <span class="badge rounded-pill bg-secondary ms-1">@CountOf("Đã hủy")</span>
                        }
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- DANH SÁCH ĐƠN HÀNG -->
    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 90px;">Mã ĐH</th>
                            <th>Ngày đặt hàng</th>
                            <th>Địa chỉ nhận hàng</th>
                            <th class="text-end">Tổng tiền</th>
                            <th class="text-center" style="width: 150px;">Trạng thái</th>
                            <th class="text-center" style="width: 180px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold text-primary">#@item.OrderID</td>
                                <td>
                                    <div>@item.OrderDate.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@item.OrderDate.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 250px;" title="@item.AddressDelivery">
                                        @item.AddressDelivery
                                    </div>
                                </td>
                                <td class="text-end fw-bold text-danger">
                                    @string.Format("{0:N0} đ", item.TotalAmount)
                                </td>
                                <td class="text-center">
                                    @if (item.PaymentStatus == "Đang xử lý" || item.PaymentStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">⏳ Đang xử lý</span>
                                    }
                                    else if (item.PaymentStatus == "Đã xác nhận")
                                    {
                                        <span class="badge bg-primary px-3 py-2 rounded-pill">✅ Đã xác nhận</span>
                                    }
                                    else if (item.PaymentStatus == "Đang giao")
                                    {
                                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill">🚚 Đang giao</span>
                                    }
                                    else if (item.PaymentStatus == "Đã giao")
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">🎉 Đã giao</span>
                                    }
                                    else if (item.PaymentStatus == "Đã hủy" || item.PaymentStatus == "Cancelled")
                                    {
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">❌ Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark px-3 py-2 rounded-pill border">@item.PaymentStatus</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a href="@Url.Action("OrderSuccess", "Order", new { id = item.OrderID })"
                                           class="btn btn-sm btn-outline-primary">
                                            Xem chi tiết
                                        </a>

                                        @if (item.PaymentStatus == "Đang xử lý" || item.PaymentStatus == "Pending")
                                        {
                                            using (Html.BeginForm("CancelOrder", "Order", new { id = item.OrderID }, FormMethod.Post, new { style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không?');">
                                                    Hủy
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <div style="font-size: 50px;">📦</div>
                <h5 class="fw-bold text-dark mt-2">Chưa có đơn hàng nào</h5>
                <p class="text-muted small">
                    @if (currentStatus == "All")
                    {
                        <span>Bạn chưa phát sinh đơn đặt hàng nào trên MyStore.</span>
                    }
                    else
                    {
                        <span>Không có đơn hàng nào ở trạng thái "<strong>@currentStatus</strong>".</span>
                    }
                </p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary px-4 mt-2">
                    🛒 Mua sắm ngay
                </a>
            </div>
        </div>
    }
</div>

<style>
    .order-status-tabs .nav-link {
        border: none !important;
        border-bottom: 3px solid transparent !important;
        white-space: nowrap;
        font-size: 14px;
        transition: all 0.2s ease;
    }
    .order-status-tabs .nav-link.active {
        border-bottom: 3px solid #0d6efd !important;
        background-color: transparent !important;
    }
</style>
