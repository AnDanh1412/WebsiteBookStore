@model _25dh110017_Mystore.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderID;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var orderDetails = ViewBag.OrderDetails as List<_25dh110017_Mystore.Models.OrderDetail>;
}

<div class="container-fluid my-4">
    <div class="d-flex align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">📄 Chi tiết Đơn hàng #@Model.OrderID</h2>
    </div>

    <div class="card shadow-sm border-0 rounded-3 p-4 mb-4">
        <div class="row">
            <div class="col-md-6 mb-3">
                <p class="mb-2"><strong>Khách hàng:</strong> @(Model.Customer != null ? Model.Customer.CustomerName : "Khách vãng lai")</p>
                <p class="mb-2"><strong>Số điện thoại:</strong> @(Model.Customer != null ? Model.Customer.CustomerPhone : "N/A")</p>
                <p class="mb-2"><strong>Ngày đặt hàng:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="col-md-6 mb-3">
                <p class="mb-2"><strong>Địa chỉ giao hàng:</strong> @Model.AddressDelivery</p>
                <p class="mb-2">
                    <strong>Trạng thái:</strong>
                    @if (Model.PaymentStatus == "Đang xử lý" || Model.PaymentStatus == "Pending")
                    {
                        <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">⏳ Đang xử lý</span>
                    }
                    else if (Model.PaymentStatus == "Đã xác nhận")
                    {
                        <span class="badge bg-primary px-3 py-1 rounded-pill">✅ Đã xác nhận</span>
                    }
                    else if (Model.PaymentStatus == "Đang giao")
                    {
                        <span class="badge bg-info text-dark px-3 py-1 rounded-pill">🚚 Đang giao</span>
                    }
                    else if (Model.PaymentStatus == "Đã giao")
                    {
                        <span class="badge bg-success px-3 py-1 rounded-pill">🎉 Đã giao</span>
                    }
                    else if (Model.PaymentStatus == "Đã hủy" || Model.PaymentStatus == "Cancelled")
                    {
                        <span class="badge bg-secondary px-3 py-1 rounded-pill">❌ Đã hủy</span>
                    }
                    else
                    {
                        <span class="badge bg-light text-dark px-3 py-1 rounded-pill border">@Model.PaymentStatus</span>
                    }
                </p>
                <p class="mb-2"><strong>Tổng giá trị:</strong> <span class="text-danger fw-bold fs-5">@string.Format("{0:N0} VNĐ", Model.TotalAmount)</span></p>
            </div>
        </div>

        <h5 class="fw-bold text-dark mt-4 mb-3">🛒 Danh sách sản phẩm trong đơn</h5>
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tên sản phẩm</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-center" style="width: 100px;">Số lượng</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (orderDetails != null && orderDetails.Any())
                    {
                        foreach (var detail in orderDetails)
                        {
                            <tr>
                                <td class="fw-bold">
                                    @(detail.Product != null ? detail.Product.ProductName : (!string.IsNullOrEmpty(detail.ProductName) ? detail.ProductName : "Sản phẩm đã mua"))
                                    @if (detail.Product == null)
                                    {
                                        <span class="badge bg-secondary ms-1">Đã xóa khỏi kệ hàng</span>
                                    }
                                </td>
                                <td class="text-end">@string.Format("{0:N0} VNĐ", detail.UnitPrice)</td>
                                <td class="text-center">@detail.Quantity</td>
                                <td class="text-end text-danger fw-bold">@string.Format("{0:N0} VNĐ", detail.UnitPrice * detail.Quantity)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Không có sản phẩm nào trong chi tiết đơn hàng.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4 pt-3 border-top d-flex gap-2">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">← Quay lại danh sách đơn hàng</a>
            <a href="@Url.Action("Edit", new { id = Model.OrderID })" class="btn btn-warning px-4">✏️ Chỉnh sửa đơn hàng</a>
        </div>
    </div>
</div>
