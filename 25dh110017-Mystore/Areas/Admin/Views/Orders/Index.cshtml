@model IEnumerable<_25dh110017_Mystore.Models.Order>

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    string currentStatus = ViewBag.CurrentStatus as string ?? "All";
    var counts = ViewBag.Counts as Dictionary<string, int> ?? new Dictionary<string, int>();

    int CountOf(string key) => counts.ContainsKey(key) ? counts[key] : 0;
}

<div class="container-fluid my-4">
    <!-- TIÊU ĐỀ TRANG -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">📦 Quản lý đơn hàng</h2>
            <p class="text-muted small mb-0">Theo dõi, xác nhận và xử lý tiến độ giao hàng</p>
        </div>
    </div>

    <!-- THANH TABS TRẠNG THÁI (KIỂU TIKTOK SHOP / SHOPEE) -->
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body p-0">
            <ul class="nav nav-tabs nav-fill border-0 flex-nowrap overflow-auto order-status-tabs">
                <li class="nav-item">
                    <a class="nav-link py-3 @(currentStatus == "All" ? "active fw-bold text-primary" : "text-secondary")"
                       href="@Url.Action("Index", "Orders", new { status = "All" })">
                        Tất cả
                        <span class="badge rounded-pill bg-light text-dark ms-1">@CountOf("All")</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-3 @(currentStatus == "Đang xử lý" ? "active fw-bold text-warning" : "text-secondary")"
                       href="@Url.Action("Index", "Orders", new { status = "Đang xử lý" })">
                        ⏳ Chờ xử lý
                        @if (CountOf("Đang xử lý") > 0)
                        {
                            <span class="badge rounded-pill bg-warning text-dark ms-1">@CountOf("Đang xử lý")</span>
                        }
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-3 @(currentStatus == "Đã xác nhận" ? "active fw-bold text-primary" : "text-secondary")"
                       href="@Url.Action("Index", "Orders", new { status = "Đã xác nhận" })">
                        ✅ Đã xác nhận
                        @if (CountOf("Đã xác nhận") > 0)
                        {
                            <span class="badge rounded-pill bg-primary ms-1">@CountOf("Đã xác nhận")</span>
                        }
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-3 @(currentStatus == "Đang giao" ? "active fw-bold text-info" : "text-secondary")"
                       href="@Url.Action("Index", "Orders", new { status = "Đang giao" })">
                        🚚 Đang giao
                        @if (CountOf("Đang giao") > 0)
                        {
                            <span class="badge rounded-pill bg-info text-dark ms-1">@CountOf("Đang giao")</span>
                        }
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-3 @(currentStatus == "Đã giao" ? "active fw-bold text-success" : "text-secondary")"
                       href="@Url.Action("Index", "Orders", new { status = "Đã giao" })">
                        🎉 Đã giao
                        @if (CountOf("Đã giao") > 0)
                        {
                            <span class="badge rounded-pill bg-success ms-1">@CountOf("Đã giao")</span>
                        }
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-3 @(currentStatus == "Đã hủy" ? "active fw-bold text-danger" : "text-secondary")"
                       href="@Url.Action("Index", "Orders", new { status = "Đã hủy" })">
                        ❌ Đã hủy
                        @if (CountOf("Đã hủy") > 0)
                        {
                            <span class="badge rounded-pill bg-secondary ms-1">@CountOf("Đã hủy")</span>
                        }
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH ĐƠN HÀNG -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 80px;">Mã ĐH</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt hàng</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center" style="width: 140px;">Trạng thái</th>
                        <th class="text-center" style="width: 180px;">Chuyển nhanh</th>
                        <th class="text-center" style="width: 170px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold text-primary">#@item.OrderID</td>
                                <td>
                                    <div class="fw-bold text-dark">@(item.Customer != null ? item.Customer.CustomerName : "Khách vãng lai")</div>
                                    <small class="text-muted">@(item.Customer != null ? item.Customer.CustomerPhone : "")</small>
                                </td>
                                <td>
                                    <div>@item.OrderDate.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@item.OrderDate.ToString("HH:mm")</small>
                                </td>
                                <td class="text-end fw-bold text-danger">
                                    @string.Format("{0:N0} đ", item.TotalAmount)
                                </td>
                                <td class="text-center">
                                    @if (item.PaymentStatus == "Đang xử lý" || item.PaymentStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">⏳ Đang xử lý</span>
                                    }
                                    else if (item.PaymentStatus == "Đã xác nhận")
                                    {
                                        <span class="badge bg-primary px-3 py-2 rounded-pill">✅ Đã xác nhận</span>
                                    }
                                    else if (item.PaymentStatus == "Đang giao")
                                    {
                                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill">🚚 Đang giao</span>
                                    }
                                    else if (item.PaymentStatus == "Đã giao")
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">🎉 Đã giao</span>
                                    }
                                    else if (item.PaymentStatus == "Đã hủy" || item.PaymentStatus == "Cancelled")
                                    {
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">❌ Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark px-3 py-2 rounded-pill border">@item.PaymentStatus</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <!-- NÚT CHUYỂN TRẠNG THÁI NHANH THEO TIẾN TRÌNH -->
                                    @if (item.PaymentStatus == "Đang xử lý" || item.PaymentStatus == "Pending")
                                    {
                                        using (Html.BeginForm("UpdateStatus", "Orders", new { id = item.OrderID, newStatus = "Đã xác nhận", currentTab = currentStatus }, FormMethod.Post, new { style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                ✅ Xác nhận
                                            </button>
                                        }
                                        using (Html.BeginForm("UpdateStatus", "Orders", new { id = item.OrderID, newStatus = "Đã hủy", currentTab = currentStatus }, FormMethod.Post, new { style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger ms-1" onclick="return confirm('Hủy đơn hàng này?');">
                                                Hủy
                                            </button>
                                        }
                                    }
                                    else if (item.PaymentStatus == "Đã xác nhận")
                                    {
                                        using (Html.BeginForm("UpdateStatus", "Orders", new { id = item.OrderID, newStatus = "Đang giao", currentTab = currentStatus }, FormMethod.Post, new { style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-info text-dark">
                                                🚚 Giao hàng
                                            </button>
                                        }
                                    }
                                    else if (item.PaymentStatus == "Đang giao")
                                    {
                                        using (Html.BeginForm("UpdateStatus", "Orders", new { id = item.OrderID, newStatus = "Đã giao", currentTab = currentStatus }, FormMethod.Post, new { style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success">
                                                🎉 Đã giao
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Đã hoàn tất</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a href="@Url.Action("Details", "Orders", new { id = item.OrderID })"
                                           class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                            Chi tiết
                                        </a>
                                        <a href="@Url.Action("Edit", "Orders", new { id = item.OrderID })"
                                           class="btn btn-sm btn-outline-warning" title="Sửa">
                                            Sửa
                                        </a>
                                        <a href="@Url.Action("Delete", "Orders", new { id = item.OrderID })"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này không?');" title="Xóa">
                                            Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <div style="font-size: 40px;">📭</div>
                                <div class="mt-2">Không có đơn hàng nào trong mục này.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .order-status-tabs .nav-link {
        border: none !important;
        border-bottom: 3px solid transparent !important;
        white-space: nowrap;
        font-size: 14px;
        transition: all 0.2s ease;
    }
    .order-status-tabs .nav-link.active {
        border-bottom: 3px solid #0d6efd !important;
        background-color: transparent !important;
    }
</style>
