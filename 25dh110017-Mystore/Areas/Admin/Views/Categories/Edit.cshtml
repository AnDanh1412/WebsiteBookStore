@model _25dh110017_Mystore.Models.Category

@{
    ViewBag.Title = "Chỉnh sửa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid my-4" style="max-width: 650px;">
    <div class="d-flex align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">✏️ Chỉnh sửa danh mục</h2>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            @using (Html.BeginForm("Edit", "Categories", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.CategoryID)

                <div class="mb-3">
                    @Html.LabelFor(model => model.CategoryName, "Tên danh mục", htmlAttributes: new { @class = "form-label fw-bold text-secondary" })
                    @Html.EditorFor(model => model.CategoryName, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên danh mục..." } })
                    @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-4">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">← Quay lại danh sách</a>
                    <button type="submit" class="btn btn-warning px-4 fw-bold">💾 Lưu thay đổi</button>
                </div>
            }
        </div>
    </div>
</div>
